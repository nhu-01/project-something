# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DATABASE_URL=            # Tiger Data connection string
USE_LOCAL_DB=            # 1 = use the embedded dev database instead of DATABASE_URL
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (rider frames, cached voice clips)
ELEVENLABS_API_KEY=      # voice; without it the phone's built-in voice is used
ELEVENLABS_VOICE_FEMALE= # optional voice ids; default to premade voices
ELEVENLABS_VOICE_MALE=
HASH_SALT=               # random string; signs ride tokens and anonymizes riders
ALLOW_SCREEN_FRAMES=     # 1 = accept potholes shown on a screen/print (indoor testing only)
ADMIN_KEY=               # random string; unlocks maintenance endpoints such as /api/admin/merge
MIN_NEW_SEVERITY=        # lowest severity that creates a new hazard (default 2)
CRON_SECRET=             # random string; Vercel Cron uses it to call the daily 311 sync
NYC_OPEN_DATA_TOKEN=     # optional NYC Open Data app token (higher rate limits)
